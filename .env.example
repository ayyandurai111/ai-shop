NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Demo account (replaces Google/GitHub login). Works in production too.
# DEMO_USER_ID must be a real user id from Supabase Auth > Users (create one with any email + password).
DEMO_USER_ID=

# Dev-only shortcut (ignored when NODE_ENV=production).
# DEV_USER_ID must be a real user id from Supabase Auth > Users.
MCP_DEV_TOKEN=
DEV_USER_ID=

ADMIN_TOKEN=
MAX_LIMIT=200

# Free Groq API key for /api/chat (get one at https://console.groq.com/keys)
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Optional: any OpenAI-compatible endpoint. Default is Groq.
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Channel3 product API (free hackathon key: https://trychannel3.com/developers, promo PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=
