{
  "name": "ai-shop-mcp",
  "version": "1.0.0",
  "description": "Autonomous AI shopping assistant and MCP server featuring live Channel3 retail search, AG Grid comparison, and zero-friction vaulted PayPal payments.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "seed:channel3": "tsx --env-file=.env scripts/import-channel3.ts",
    "test:smoke": "tsx --env-file=.env scripts/smoke-test.ts",
    "test:oauth": "tsx --env-file=.env scripts/oauth-test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "express": "^4.21.0",
    "typescript": "^5.6.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
